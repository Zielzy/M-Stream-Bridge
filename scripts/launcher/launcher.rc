1 ICON "src/assets/mstream.ico"

1 VERSIONINFO
FILEVERSION __VERSION_CSV__
PRODUCTVERSION __VERSION_CSV__
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zielzy"
            VALUE "FileDescription", "M-Stream Bridge"
            VALUE "FileVersion", "__VERSION_FILE_STR__"
            VALUE "InternalName", "M-Stream Bridge"
            VALUE "LegalCopyright", "Copyright (c) 2026 Zielzy"
            VALUE "OriginalFilename", "M-Stream Bridge.exe"
            VALUE "ProductName", "M-Stream Bridge"
            VALUE "ProductVersion", "__VERSION_STR__"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
